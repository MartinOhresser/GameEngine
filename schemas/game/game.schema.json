{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "action_control",
          "camera2d",
          "collision2d",
          "debug_draw",
          "lifetime",
          "pickup",
          "screen_wrap",
          "sprite2d",
          "transform2d"
        ]
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "tick_rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "properties": {
        "action_control": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "camera2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "collision2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "debug_draw": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "lifetime": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "pickup": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "screen_wrap": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "sprite2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "transform2d": {
          "type": "object",
          "properties": {
            "speed_scale": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "prefabs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input": {
      "type": "string"
    },
    "start_scene": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game manifest",
  "required": [
    "schema_version",
    "name",
    "modules"
  ]
}
