{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "icon": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "action_control",
          "aim2d",
          "autofire",
          "bind",
          "bounce2d",
          "bounds2d",
          "camera2d",
          "collision2d",
          "combat2d",
          "debug_draw",
          "economy",
          "follow2d",
          "gesture",
          "gravity2d",
          "grid2d",
          "grid_moves",
          "health",
          "host",
          "inventory",
          "jump",
          "lifetime",
          "light2d",
