          "postfx",
          "progress",
          "records",
          "reserve",
          "rules",
          "scene_switch",
          "screen_wrap",
          "slide_merge",
          "spawner2d",
          "sprite2d",
          "tag",
          "terrain2d",
          "text2d",
          "touch_controls",
          "transform2d",
          "turns",
          "tween2d",
          "ui",
          "waves"
        ]
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "tick_rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "adapt": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "min_aspect": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_aspect": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
