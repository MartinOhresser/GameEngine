{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "icon": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "action_control",
          "altitude",
          "bounce2d",
          "camera2d",
          "collision2d",
          "combat2d",
          "debug_draw",
          "gravity2d",
          "host",
          "inventory",
          "lifetime",
          "patrol2d",
          "pickup",
          "records",
          "scene_switch",
          "screen_wrap",
          "spawner2d",
          "sprite2d",
          "text2d",
          "transform2d",
          "ui"
        ]
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "tick_rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "properties": {
        "action_control": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "altitude": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "bounce2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "camera2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "collision2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "combat2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "debug_draw": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "gravity2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "host": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "inventory": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "lifetime": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "patrol2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "pickup": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "records": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "scene_switch": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "screen_wrap": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "spawner2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "sprite2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "text2d": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "transform2d": {
          "type": "object",
          "properties": {
            "speed_scale": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "additionalProperties": false
        },
        "ui": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "lists": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "atlases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prefabs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input": {
      "type": "string"
    },
    "start_scene": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game manifest",
  "required": [
    "schema_version",
    "name",
    "modules"
  ]
}
