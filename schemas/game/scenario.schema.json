{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string"
    },
    "ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "value": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "tick",
          "action"
        ]
      }
    },
    "expect": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 3
          },
          {
            "type": "object",
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "check": {
                "type": "string",
                "minLength": 3
              }
            },
            "additionalProperties": false,
            "required": [
              "check"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenario",
  "required": [
    "schema_version",
    "name",
    "ticks"
  ]
}
