{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "sources": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^(key|mouse|pad|touch):[a-z0-9_]+$"
            },
            "additionalProperties": {
              "type": "number"
            },
            "minProperties": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "action",
          "sources"
        ]
      }
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Input bindings",
  "required": [
    "schema_version",
    "bindings"
  ]
}
