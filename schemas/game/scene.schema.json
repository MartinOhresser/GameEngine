{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "prefab": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "components": {
            "type": "object",
            "properties": {
              "action_control.Controlled": {
                "type": "object",
                "properties": {
                  "speed": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              "lifetime.Lifetime": {
                "type": "object",
                "properties": {
                  "ticks": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  }
                },
                "additionalProperties": false
              },
              "screen_wrap.WrapArea": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              "transform2d.Position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              "transform2d.Velocity": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene",
  "required": [
    "schema_version",
    "name",
    "entities"
  ]
}
