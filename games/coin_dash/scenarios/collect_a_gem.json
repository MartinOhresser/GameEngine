// Fly down at 2 units per tick. The gem is at y=391: touched within 24 units,
// i.e. y >= 367, which the ship reaches after 34 ticks (300 + 2 * 34 = 368).
{
  "schema_version": 1,
  "name": "collect_a_gem",
  "ticks": 60,
  "inputs": [{ "tick": 0, "action": "move_y", "value": 1 }],
  "expect": [
    { "at": 33, "check": "gem_below alive" },
    { "at": 34, "check": "gem_below gone" },
    { "at": 34, "check": "ship.pickup.Collector.score == 50" },  // a gem is worth 50
    "coin_right alive",
    "ship.pickup.Collector.score == 50",
  ],
}
