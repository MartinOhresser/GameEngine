// "Slide the tiles, make 2048."
// A 2048: four by four cells; one move slides every tile as far as it goes and two equal tiles
// make their sum (module slide_merge); a 2 (sometimes a 4) is added after each move that changed
// something; the game is won at 2048 (the victory screen offers to go on), lost when nothing can
// move any more, and a new game starts at any time (R, N or the button). Arrows, W A S D, a swipe
// or a drag. The best score is saved. No game code: the rules are modules, and the screens are
// phases of the game (module phase).
// Pictures, prefabs, scenes and scenarios are generated by tools/make_assets.py.
{
  "schema_version": 1,
  "name": "game_2048",
  "title": "2048",
  "description": "Slide the tiles with the arrow keys, W A S D or a swipe: two equal tiles make their sum. Reach 2048, then keep going if you like. R or the button starts a new game; the best score is kept.",
  "modules": [
    "transform2d", "collision2d", "camera2d", "grid2d", "gesture", "slide_merge", "tween2d", "rules", "phase",
    "sprite2d", "text2d", "scene_switch", "ui", "records",
  ],
  "simulation": { "tick_rate": 60, "seed": 2048 },
  // A tall window, as on a phone: 480 wide, and as high as the screen is. The board is fitted
  // into what the interface leaves of it (camera2d.CameraFit), whatever the shape of the screen.
  "window": { "width": 480, "height": 720, "adapt": true },
  "input": "input.json",
  "lists": {
    "grid": ["board"],
    // The screens of the game: the board answers in the first one only.
    "phase": ["playing", "won", "lost"],
    // The first four slide the board; `moved` and `stuck` come from it, `deal` and `goal` from the
    // rules, the others from the keys and the buttons.
    "action": ["left", "right", "up", "down", "moved", "stuck", "deal", "goal", "new_game", "continue_game"],
    "menu": ["game_menu"],
    "tag": ["board", "scoreboard"],
    "record": ["best_score"],
  },
  "atlases": ["art/tiles.json", "art/ui.json", "art/font.json"],
  "strings": ["text/en.json", "text/fr.json"],
  "locale": "en",
  "prefabs": [
    "prefabs/tile.json",
    "prefabs/tile_four.json",
    "prefabs/button.json",
  ],
  "scenes": [
    "scenes/boot.json",
    "scenes/game.json",
    "scenes/test_merge.json",
    "scenes/test_four_equal.json",
    "scenes/test_walk.json",
    "scenes/test_packed.json",
    "scenes/test_spawn.json",
    "scenes/test_win.json",
    "scenes/test_lost.json",
  ],
  "scenarios": [
    "scenarios/deal_two_tiles.json",
    "scenarios/tiles_merge.json",
    "scenarios/merged_tile_pops.json",
    "scenarios/merges_once_per_move.json",
    "scenarios/slides_in_four_directions.json",
    "scenarios/move_without_effect_adds_nothing.json",
    "scenarios/move_adds_a_tile.json",
    "scenarios/swipe_slides_the_board.json",
    "scenarios/tap_is_not_a_swipe.json",
    "scenarios/reaching_2048_shows_the_victory.json",
    "scenarios/continue_after_2048.json",
    "scenarios/continue_with_the_button.json",
    "scenarios/no_more_moves_ends_the_game.json",
    "scenarios/new_game_with_r.json",
    "scenarios/new_game_with_the_button.json",
  ],
  "start_scene": "boot",
}
