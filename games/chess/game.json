// "Two players, one board."
// Chess for two players on one screen: a touch (or a click) on a piece shows where it can go,
// a second one plays the move. Every rule is data: the way each piece moves is an entity (a
// Pattern of module grid_moves), a king is a Guard (a move that leaves it threatened is not
// offered, and "check", "mate" and "stalemate" are what the sides report), castling and the
// capture in passing are patterns with a condition, and the choice of a piece when a pawn
// reaches the far rank is a phase of the game with a menu. No game code.
// Pictures, prefabs, scenes and the manifest are generated by tools/make_assets.py.
{
  "schema_version": 1,
  "name": "chess",
  "title": "Chess",
  "description": "Chess for two players on one screen. Touch a piece, then a square it can go to. Check, mate, stalemate, castling, the capture in passing and the promotion of pawns are all there. R or the button starts a new game.",
  "modules": [
    "transform2d",
    "collision2d",
    "camera2d",
    "grid2d",
    "turns",
    "grid_moves",
    "rules",
    "phase",
    "sprite2d",
    "text2d",
    "scene_switch",
    "ui"
  ],
  "simulation": {
    "tick_rate": 60,
    "seed": 1
  },
  "window": {
    "width": 480,
    "height": 720,
    "adapt": true
  },
  "input": "input.json",
  "lists": {
    "grid": [
      "board"
    ],
    "phase": [
      "playing",
      "promotion",
      "white_won",
      "black_won",
      "draw"
    ],
    "mover_kind": [
      "pawn",
      "knight",
      "bishop",
      "rook",
      "queen",
      "king"
    ],
    "action": [
      "moved",
      "refused",
      "white_mated",
      "black_mated",
      "stalemate",
      "check_on",
      "check_off",
      "need_promotion",
      "promote_queen",
      "promote_rook",
      "promote_bishop",
      "promote_knight",
      "resign_white",
      "resign_black",
      "new_game"
    ],
    "menu": [
      "game_menu",
      "promotion_menu"
    ],
    "tag": [
      "side_white",
      "side_black",
      "check_text",
      "promotion_top",
      "promotion_bottom"
    ]
  },
  "atlases": [
    "art/pieces.json",
    "art/ui.json",
    "art/font.json"
  ],
  "strings": [
    "text/en.json",
    "text/fr.json"
  ],
  "locale": "en",
  "prefabs": [
    "prefabs/piece.json",
    "prefabs/button.json"
  ],
  "scenes": [
    "scenes/game.json",
    "scenes/test_pin.json",
    "scenes/test_check.json",
    "scenes/test_stalemate.json",
    "scenes/test_castle.json",
    "scenes/test_castle_threat.json",
    "scenes/test_en_passant.json",
    "scenes/test_promotion.json",
    "scenes/test_promotion_mate.json"
  ],
  "scenarios": [
    "scenarios/start_position.json",
    "scenarios/pawn_moves_one_or_two.json",
    "scenarios/only_the_player_to_move_plays.json",
    "scenarios/illegal_moves_are_not_played.json",
    "scenarios/a_pinned_piece_cannot_move.json",
    "scenarios/a_check_must_be_answered.json",
    "scenarios/fools_mate.json",
    "scenarios/scholars_mate.json",
    "scenarios/stalemate_is_a_draw.json",
    "scenarios/castling_on_both_sides.json",
    "scenarios/no_castling_through_a_threatened_square.json",
