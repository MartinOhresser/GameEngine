// A button of a menu: a picture, its text, and the menu group it belongs to.
{
  "schema_version": 1,
  "name": "button",
  "components": {
    "transform2d.Position": {},
    "sprite2d.Sprite": {
      "atlas": "ui", "frame": 1, "width": 240, "height": 48, "screen": true, "layer": 10
    },
    "text2d.Text": { "font": "font", "size": 22, "pivot_x": 0.5, "pivot_y": 0.5, "screen": true },
    "ui.Button": { "menu": "main_menu", "width": 240, "height": 48, "normal_frame": 1, "focus_frame": 2 }
  }
}
