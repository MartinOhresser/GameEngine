// "Climb as high as you can: bounce from platform to platform, avoid or shoot the monsters."
// A Doodle Jump: the player bounces by itself (gravity2d + bounce2d), the camera only climbs,
// the world is built ahead of it (spawner2d) with more and more difficulty, falling or touching
// a monster ends the game, the score is the height and the best one is saved.
// Pictures are generated by tools/make_assets.py (and the scenes with them).
{
  "schema_version": 1,
  "name": "doodle_jump",
  "title": "Doodle Jump",
  "description": "Left and right (arrows or A and D) steer the jumper, which bounces by itself on every platform it lands on. Space or Up shoots upwards. The score is the height; the best one is kept between two runs.",
  "modules": [
    "transform2d", "gravity2d", "action_control", "screen_wrap", "collision2d", "bounce2d",
    "patrol2d", "camera2d", "spawner2d", "health", "bounds2d", "combat2d", "progress", "lifetime",
    "sprite2d", "text2d", "scene_switch", "ui", "records", "host", "touch_controls",
  ],
  "simulation": { "tick_rate": 60, "seed": 2024 },
  // A tall window, as on a phone: 480 wide, and as high as the screen is (from the shape of a
  // tablet to the longest phones), so every phone is filled. The interface is anchored to the
  // edges (`ui.Anchor`), the world is built ahead of whatever height the screen shows.
  "window": { "width": 480, "height": 720, "adapt": true },
  "input": "input.json",
  "lists": {
    // The things that bump into each other, one bit each (the order is fixed by the prefabs).
    "layer": ["player", "platform", "monster", "bullet"],
    // `died` is raised by the jumper's death; the others come from the buttons.
    "action": ["died", "start_game", "restart_game", "show_menu", "quit_game", "move_x", "shoot"],
    "menu": ["main_menu", "gameover_menu"],
    "group": ["menu_buttons", "gameover_buttons", "touch_stick"],
    "tag": ["player", "scoreboard"],
    // The names under which numbers are saved between two runs of the program.
    "record": ["best_height"],
  },
  "atlases": ["art/doodle.json", "art/ui.json", "art/font.json"],
  "strings": ["text/en.json", "text/fr.json"],
  "locale": "en",
  "prefabs": [
    "prefabs/platform.json",
    "prefabs/platform_moving.json",
    "prefabs/platform_vanishing.json",
    "prefabs/platform_breakable.json",
    "prefabs/spring.json",
    "prefabs/monster.json",
    "prefabs/monster_flying.json",
    "prefabs/bullet.json",
    "prefabs/player.json",
    "prefabs/camera.json",
    "prefabs/button.json",
  ],
  "scenes": [
    "scenes/boot.json",
    "scenes/menu.json",
    "scenes/game.json",
    "scenes/gameover.json",
    "scenes/test_wrap.json",
    "scenes/test_spring.json",
    "scenes/test_breaks.json",
    "scenes/test_vanishes.json",
    "scenes/test_moving.json",
    "scenes/test_monster_touch.json",
    "scenes/test_monster_stomp.json",
    "scenes/test_monster_shoot.json",
  ],
  "scenarios": [
    "scenarios/gravity_pulls.json",
    "scenarios/bounce_on_platform.json",
    "scenarios/steer_and_wrap.json",
    "scenarios/spring_throws_high.json",
    "scenarios/camera_only_climbs.json",
    "scenarios/score_counts_height.json",
    "scenarios/breakable_gives_way.json",
    "scenarios/vanishing_bounces_once.json",
    "scenarios/moving_platform_turns.json",
    "scenarios/monster_kills.json",
    "scenarios/stomp_kills_monster.json",
    "scenarios/shot_kills_monster.json",
    "scenarios/monster_survives_without_a_shot.json",
    "scenarios/falling_ends_the_game.json",
    "scenarios/world_builds_itself.json",
    "scenarios/play_from_the_menu.json",
    "scenarios/game_over_shows_score.json",
    "scenarios/play_again_with_r.json",
    "scenarios/play_again_with_button.json",
    "scenarios/touch_stick_steers.json",
    "scenarios/back_to_menu.json",
    "scenarios/quit_from_the_menu.json",
    "scenarios/play_does_not_quit.json",
  ],
  "start_scene": "boot",
}
