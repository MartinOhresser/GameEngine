// A blue platform slides, turns at the end of its path (x = 100 to 200) and comes
// back.
{
  "schema_version": 1,
  "name": "moving_platform_turns",
  "scene": "test_moving",
  "ticks": 60,
  "expect": [
    {
      "at": 10,
      "check": "mover.transform2d.Position.x > 150"
    },
    {
      "at": 10,
      "check": "mover.transform2d.Velocity.x == 100"
    },
    {
      "at": 30,
      "check": "mover.transform2d.Position.x == 200"
    },
    {
      "at": 30,
      "check": "mover.transform2d.Velocity.x == -100"
    },
    {
      "at": 60,
      "check": "mover.transform2d.Position.x < 160"
    },
    {
      "at": 60,
      "check": "mover.transform2d.Position.x > 140"
    }
  ]
}
