// A spring throws the jumper much higher than a platform can (a platform bounce
// never takes it above y = 455 from here; the spring takes it near y = 100).
{
  "schema_version": 1,
  "name": "spring_throws_high",
  "scene": "test_spring",
  "ticks": 60,
  "expect": [
    {
      "at": 20,
      "check": "player.bounce2d.Bouncer.bounces == 0"
    },
    {
      "at": 40,
      "check": "player.bounce2d.Bouncer.bounces == 1"
    },
    {
      "at": 40,
      "check": "player.transform2d.Velocity.y < -700"
    },
    {
      "at": 60,
      "check": "player.transform2d.Position.y < 300"
    }
  ]
}
