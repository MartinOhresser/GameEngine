// A game steered by actions. Scenarios play the part of the player by scripting
// the move_x and move_y actions; in a window (geplay) the arrow keys or WASD do.
{
  "schema_version": 1,
  "name": "pilot",
  "title": "Pilot",
  "description": "One ship the player steers with the move actions.",
  "modules": ["transform2d", "screen_wrap", "action_control", "debug_draw"],
  "input": "input.json",
  "simulation": { "tick_rate": 60, "seed": 1 },
  "prefabs": ["prefabs/ship.json"],
  "scenes": ["scenes/main.json"],
  "scenarios": ["scenarios/fly_right_then_stop.json", "scenarios/idle.json", "scenarios/wraps.json"],
  "start_scene": "main",
}
