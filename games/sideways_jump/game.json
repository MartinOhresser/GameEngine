// "Run to the right: bounce from block to block, and do not fall off the left of the screen."
// Doodle Jump turned a quarter turn, with no code and no picture of its own: gravity pulls to the
// left, the jumper bounces on the right side of the blocks, the camera only goes right, the world
// is laid out to the right (spawner2d) with more and more difficulty, and the score is how far
// right the jumper got. It exists to show that the modules do not know "up" and "down": every
// direction is a setting (gravity2d.Gravity, bounce2d.Bouncer, camera2d.CameraFollow,
// spawner2d.Generator, bounds2d.OutOfView, progress.Progress).
{
  "schema_version": 1,
  "name": "sideways_jump",
  "title": "Sideways Jump",
  "description": "Up and Down (arrows or W and S) steer the jumper, which bounces by itself on every block it lands on. Run as far to the right as you can; leaving the screen on the left ends the game, and R starts again.",
  "modules": [
    "transform2d", "gravity2d", "action_control", "screen_wrap", "collision2d", "bounce2d",
    "camera2d", "spawner2d", "bounds2d", "progress", "scene_switch", "debug_draw",
  ],
  "simulation": { "tick_rate": 60, "seed": 7 },
  // A wide window, as a phone held sideways: 480 high, and as wide as the screen is.
  "window": { "width": 720, "height": 480, "adapt": true },
  "input": "input.json",
  "lists": {
    "layer": ["player", "block"],
    // `died` is raised by the jumper's death; `restart` comes from the R key.
    "action": ["died", "restart", "move_x", "move_y"],
  },
  "prefabs": ["prefabs/block.json", "prefabs/player.json", "prefabs/camera.json"],
  "scenes": ["scenes/game.json", "scenes/gameover.json", "scenes/test_fall.json"],
  "scenarios": [
    "scenarios/gravity_pulls_left.json",
    "scenarios/bounce_on_the_right_side.json",
    "scenarios/steer_up_and_down.json",
    "scenarios/camera_only_goes_right.json",
    "scenarios/score_counts_distance.json",
    "scenarios/world_builds_itself_to_the_right.json",
    "scenarios/falling_off_the_left_ends_the_game.json",
    "scenarios/play_again_with_r.json",
  ],
  "start_scene": "game",
}
