// The camera drifts to the right at 60 units a second; the planes keep their places in the
// world (their parallax is a matter of drawing, not of the simulation) and the hero breathes.
{
  "schema_version": 1,
  "name": "camera_drifts",
  "scene": "forest",
  "ticks": 120,
  "expect": [
    { "at": 0, "check": "camera.transform2d.Position.x == 640" },
    { "at": 120, "check": "camera.transform2d.Position.x > 759" },
    { "at": 120, "check": "camera.transform2d.Position.x < 761" },
    { "at": 120, "check": "far_trees.transform2d.Position.x == 192" },
    { "at": 120, "check": "hero.sprite2d.Sprite.frame < 8" },
  ],
}
