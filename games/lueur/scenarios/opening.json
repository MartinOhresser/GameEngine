// The game opens on the forest with black bars, the hero still: keys do nothing while the spirit
// comes down to him. Then the bars slide away and the hero can walk and jump.
{
  "schema_version": 1,
  "name": "opening",
  "scene": "prologue",
  "ticks": 300,
  "inputs": [
    { "tick": 0, "action": "move_x", "value": 1 },
    { "tick": 50, "action": "jump", "value": 1 },
    { "tick": 60, "action": "jump", "value": 0 },
  ],
  "expect": [
    { "at": 100, "check": "hero.transform2d.Position.x < 522" },
    { "at": 100, "check": "hero.jump.Jumper.jumps == 0" },
    { "at": 100, "check": "camera.postfx.Effects.letterbox > 0.12" },
    { "at": 100, "check": "story.phase.Phase.current == 0" },
    { "at": 100, "check": "spirit.transform2d.Position.x < 700" },
    { "at": 300, "check": "story.phase.Phase.current == 1" },
    { "at": 300, "check": "camera.postfx.Effects.letterbox == 0" },
    { "at": 300, "check": "hero.transform2d.Position.x > 900" },
  ],
}
