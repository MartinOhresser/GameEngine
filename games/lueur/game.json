// "Lueur" (glimmer): a dusk forest of silhouettes and mist, warm light low in the sky. The proof
// that the engine draws beautiful games (ADR 0015): parallax planes that fade into the fog, light
// added on top, smoothed pictures. The hero walks, runs and jumps through it, the camera following
// him loosely, a small spirit of light floating after him; the level itself comes next (B8).
// Pictures, atlases and the scene are generated by tools/make_assets.py.
{
  "schema_version": 1,
  "name": "lueur",
  "title": "Lueur",
  "description": "A dusk forest of silhouettes and mist. A child and a small spirit of light cross it: thorny pits to jump, a crate to push, pods swinging on their threads.",
  "modules": [
    "transform2d", "sprite2d", "camera2d", "collision2d", "gravity2d", "action_control", "jump",
    "light2d", "particles2d", "postfx", "tag", "follow2d", "health", "combat2d", "patrol2d",
    "scene_switch", "phase", "tween2d", "spawner2d", "bounds2d",
  ],
  "lists": {
    "action": ["move_x", "jump", "died", "opening_done"],
    "phase": ["opening", "play"],
    "layer": ["hero", "ground", "crate", "hazard", "exit"],
    "tag": ["hero"],
    "animation_set": ["hero"],
  },
  "simulation": { "tick_rate": 60, "seed": 7 },
  "window": { "width": 1280, "height": 720 },
  "input": "input.json",
  "atlases": [
    "art/sky.json", "art/glow.json", "art/ray.json", "art/ridge.json", "art/far_trees.json",
    "art/mid_trees.json", "art/near_trees.json", "art/mist_far.json", "art/mist_mid.json",
    "art/mist_near.json", "art/ground.json", "art/foreground.json", "art/hero.json",
    "art/leaves.json", "art/spirit.json", "art/crate.json", "art/stone.json", "art/ledge.json",
    "art/thorns.json", "art/pod.json", "art/shade.json", "art/black.json",
  ],
  "prefabs": ["prefabs/fade_forest.json", "prefabs/fade_hollow.json"],
  "scenes": [
    "scenes/prologue.json", "scenes/forest.json", "scenes/hollow.json", "scenes/ending.json",
  ],
  "scenarios": [
    "scenarios/walks.json", "scenarios/jumps.json", "scenarios/camera_stays_in_level.json",
    "scenarios/animates.json", "scenarios/spirit_follows.json", "scenarios/forest_through.json",
