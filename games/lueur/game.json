// "Lueur" (glimmer): a dusk forest of silhouettes and mist, warm light low in the sky. The proof
// that the engine draws beautiful games (ADR 0015): parallax planes that fade into the fog, light
// added on top, smoothed pictures. The hero walks and jumps through it (B4), the camera following
// him loosely; light, particles and the level itself come in the steps that follow.
// Pictures, atlases and the scene are generated by tools/make_assets.py.
{
  "schema_version": 1,
  "name": "lueur",
  "title": "Lueur",
  "description": "A dusk forest of silhouettes and mist. A small hero walks and jumps through it, and the planes slide past at their own speeds.",
  "modules": [
    "transform2d", "sprite2d", "camera2d", "collision2d", "gravity2d", "action_control", "jump",
    "light2d", "particles2d", "postfx",
  ],
  "lists": {
    "layer": ["hero", "ground"],
  },
  "simulation": { "tick_rate": 60, "seed": 7 },
  "window": { "width": 1280, "height": 720 },
  "input": "input.json",
  "atlases": [
    "art/sky.json", "art/glow.json", "art/ray.json", "art/ridge.json", "art/far_trees.json",
    "art/mid_trees.json", "art/near_trees.json", "art/mist_far.json", "art/mist_mid.json",
    "art/mist_near.json", "art/ground.json", "art/foreground.json", "art/hero.json",
    "art/leaves.json",
  ],
  "scenes": ["scenes/forest.json"],
  "scenarios": [
    "scenarios/walks.json", "scenarios/jumps.json", "scenarios/camera_stays_in_level.json",
  ],
  "start_scene": "forest",
}
