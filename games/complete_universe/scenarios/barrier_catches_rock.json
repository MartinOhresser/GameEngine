// The white in the right hand: a short press under the falling rock raises a small bubble, and
// the rock comes to rest on it instead of the ground. Its carbon is paid by its size.
{
  "schema_version": 1,
  "name": "barrier_catches_rock",
  "scene": "sandbox",
  "ticks": 90,
  "inputs": [
    { "tick": 0, "action": "change", "value": 1 },
    { "tick": 1, "action": "hand_right", "value": 1 },
    { "tick": 2, "action": "hand_right", "value": 0 },
    { "tick": 3, "action": "hand_right", "value": 1 },
    { "tick": 4, "action": "hand_right", "value": 0 },
    { "tick": 5, "action": "change", "value": 0 },
    { "tick": 5, "action": "pointer_x", "value": 480 },
    { "tick": 5, "action": "pointer_y", "value": 500 },
    { "tick": 7, "action": "hand_right", "value": 1 },
    { "tick": 10, "action": "hand_right", "value": 0 },
  ],
  "expect": [
    { "at": 6, "check": "hand_right.loadout.Hand.item == 1" },
    { "at": 12, "check": "barrier_1.barrier2d.Barrier.up == true" },
    { "at": 12, "check": "barrier_1.barrier2d.Barrier.round == true" },
    { "at": 12, "check": "barrier_1.transform2d.Position.x == 480" },
    // 18 to start, 70 a second for two ticks after: 20.3; the rock rests on it, half of its 22
    // units of height above the bubble's top.
    { "at": 12, "check": "barrier_1.barrier2d.Barrier.radius > 20" },
    { "at": 12, "check": "barrier_1.barrier2d.Barrier.radius < 21" },
    "falling_rock.transform2d.Position.y > 465",
    "falling_rock.transform2d.Position.y < 471",
    "falling_rock.collision2d.Blocked.below == true",
    // 20.3 × 0.06 of carbon, and the life drain of a second and a half.
    "carbon.reserve.Reserve.amount < 98.3",
    "carbon.reserve.Reserve.amount > 97.2",
  ],
}
