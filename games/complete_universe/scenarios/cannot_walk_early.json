// Before its steps (D4), the hero can neither walk nor jump, and no power works: the landing, then
// the black only.
{
  "schema_version": 1,
  "name": "cannot_walk_early",
  "scene": "tutorial",
  "ticks": 240,
  "inputs": [
    { "tick": 0, "action": "move_x", "value": 1 },
    { "tick": 30, "action": "jump", "value": 1 },
    { "tick": 60, "action": "jump", "value": 0 },
  ],
  "expect": [
    { "at": 160, "check": "story.phase.Phase.current == 0" },
    "hero.transform2d.Position.x == 600",
    "hero.jump.Jumper.jumps == 0",
    "story.phase.Phase.current == 1",
  ],
}
