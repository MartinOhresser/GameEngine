// The opening plays by itself: the explosion's flash grows and fades, the stars come, the camera
// goes over to the planet in its barrier; then the tutorial starts, with the hero falling to the
// ground.
{
  "schema_version": 1,
  "name": "opening",
  "scene": "opening",
  "ticks": 1100,
  "expect": [
    { "at": 20, "check": "flash.transform2d.Scale.factor > 4" },
    { "at": 100, "check": "flash.sprite2d.Sprite.alpha == 0" },
    { "at": 480, "check": "stars.sprite2d.Sprite.alpha == 255" },
    { "at": 622, "check": "camera.transform2d.Position.x > 699.5" },
    { "at": 810, "check": "camera.camera2d.Camera.zoom == 3.9" },
    "story.phase.Phase.current == 1",
    "hero.collision2d.Blocked.below == true",
  ],
}
