    { "at": 1210, "check": "planet_dot.sprite2d.Sprite.alpha == 255" },
    { "at": 1210, "check": "planet.sprite2d.Sprite.alpha == 0" },
    { "at": 1210, "check": "planet.transform2d.Scale.factor < 0.05" },
    { "at": 1210, "check": "planet.transform2d.Position.x > 380" },
    { "at": 1410, "check": "planet_dot.sprite2d.Sprite.alpha == 0" },
    { "at": 1410, "check": "planet.sprite2d.Sprite.alpha == 255" },
    { "at": 1410, "check": "planet.transform2d.Scale.factor < 0.2" },
    // The stars of space stay until the planet fills the screen; then its sky, hidden behind it.
    { "at": 1820, "check": "stars_1.sprite2d.Sprite.alpha == 255" },
    { "at": 1820, "check": "sky_t.sprite2d.Sprite.alpha == 0" },
