    { "at": 2270, "check": "planet.transform2d.Position.y > 2600" },
    { "at": 2272, "check": "sky_t.transform2d.Scale.factor == 1" },
    { "at": 2272, "check": "sky_t.transform2d.Position.y < -330" },
    { "at": 2272, "check": "sky_t.transform2d.Position.y > -370" },
    { "at": 2272, "check": "camera.camera2d.Camera.zoom == 1.5" },
