    // At the switch, nothing stops: he is already in his fall, the sky still rising.
    { "at": 2275, "check": "hero.sprite2d.Animator.clip == 6" },
    { "at": 2275, "check": "sky.transform2d.Position.y < -355.5" },
    { "at": 2276, "check": "sky.transform2d.Position.y < -357.5" },
    { "at": 2285, "check": "story.phase.Phase.current == 0" },
    { "at": 2490, "check": "hero.collision2d.Blocked.below == true" },
    "story.phase.Phase.current == 1",
    "hero.collision2d.Blocked.below == true",
  ],
}
