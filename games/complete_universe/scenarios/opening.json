// The opening plays by itself (D23, D24, D30): black for a while; a point of light comes,
// slowly, stays still, then trembles, a little then more; at tick 510 the explosion: the flash,
// rays, clouds of gas in colours that go out in turn, black, then the sky builds up. The white
// light of its heart fades out slowly: far off in it, the hero, who grows nearer and wanders to
// the planet: a point of light at the bottom right, which grows coming towards him, slowly then
// faster, until it fills the background, finer; while it fills the screen, the stars of space
// give way to its own sky; the pivot: it goes down, the sky rises, more than a screen (the view
// turns). Then the tutorial's scene, "arrival", the same picture: he falls to the ground, and
// the tutorial goes on.
{
  "schema_version": 1,
  "name": "opening",
  "scene": "opening",
  "ticks": 2700,
  "expect": [
    // Black, then the point comes slowly, stays still, then trembles.
    { "at": 20, "check": "seed.sprite2d.Sprite.alpha == 0" },
    { "at": 140, "check": "seed.sprite2d.Sprite.alpha == 0" },
    { "at": 210, "check": "seed.sprite2d.Sprite.alpha > 50" },
    { "at": 210, "check": "seed.sprite2d.Sprite.alpha < 200" },
    { "at": 330, "check": "seed.sprite2d.Sprite.alpha == 255" },
    { "at": 330, "check": "seed.transform2d.Scale.factor > 0.35" },
    { "at": 380, "check": "seed.transform2d.Position.x == 0" },
    { "at": 380, "check": "seed.transform2d.Position.y == 0" },
    { "at": 490, "check": "seed.transform2d.Scale.factor > 0.7" },
    { "at": 330, "check": "flash.sprite2d.Sprite.alpha == 0" },
    { "at": 330, "check": "core.sprite2d.Sprite.alpha == 0" },
    { "at": 330, "check": "wanderer.sprite2d.Sprite.alpha == 0" },
    // The explosion.
    { "at": 530, "check": "flash.transform2d.Scale.factor > 3" },
    { "at": 530, "check": "seed.sprite2d.Sprite.alpha == 0" },
    { "at": 550, "check": "rays_a.sprite2d.Sprite.alpha > 150" },
    { "at": 585, "check": "stars_1.sprite2d.Sprite.alpha == 0" },
    { "at": 610, "check": "flash.sprite2d.Sprite.alpha == 0" },
    { "at": 610, "check": "core.sprite2d.Sprite.alpha == 255" },
    { "at": 610, "check": "cloud_0.sprite2d.Sprite.alpha > 100" },
    { "at": 710, "check": "stars_1.sprite2d.Sprite.alpha == 255" },
    { "at": 710, "check": "stars_3.sprite2d.Sprite.alpha == 0" },
    { "at": 995, "check": "core.sprite2d.Sprite.alpha == 0" },
    { "at": 995, "check": "wanderer.transform2d.Scale.factor > 0.25" },
    { "at": 995, "check": "gas_colour.sprite2d.Sprite.alpha == 0" },
    { "at": 1240, "check": "wanderer.transform2d.Scale.factor == 1" },
    { "at": 1240, "check": "cloud_0.sprite2d.Sprite.alpha == 0" },
    { "at": 1240, "check": "cloud_21.sprite2d.Sprite.alpha > 60" },
