// With 8 carbon and nothing to harvest, the white runs out after about 58 seconds (the body lasts
// twelve minutes full): the hero stops, the screen goes black, and the checkpoint puts him back
// where he was, with what he had (D7).
{
  "schema_version": 1,
  "name": "dies_and_restarts",
  "scene": "sandbox_low",
  "ticks": 3600,
  "inputs": [
    { "tick": 0, "action": "move_x", "value": 1 },
    { "tick": 60, "action": "move_x", "value": 0 },
  ],
  "expect": [
    { "at": 100, "check": "hero.transform2d.Position.x > 600" },
    { "at": 3400, "check": "dead.toggle.Toggle.on == false" },
    // 8 / (100 / 720 a second) = 57.6 seconds: 3456 ticks.
    { "at": 3470, "check": "carbon.reserve.Reserve.amount == 0" },
    { "at": 3470, "check": "dead.toggle.Toggle.on == true" },
    { "at": 3470, "check": "hero.transform2d.Position.x > 600" },
    // The fade lasts 60 ticks; then everything is back as it was at the start.
    "dead.toggle.Toggle.on == false",
    "checkpoint.checkpoint.Checkpoint.loads == 1",
    "hero.transform2d.Position.x > 399",
    "hero.transform2d.Position.x < 402",
    // 8 again, less the drain since.
    "carbon.reserve.Reserve.amount > 7.7",
  ],
}
