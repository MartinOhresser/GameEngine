// With 8 carbon and nothing to harvest, the white runs out after 24 seconds: the hero stops, the
// screen goes black, and the checkpoint puts him back where he was, with what he had (D7).
{
  "schema_version": 1,
  "name": "dies_and_restarts",
  "scene": "sandbox_low",
  "ticks": 1600,
  "inputs": [
    { "tick": 0, "action": "move_x", "value": 1 },
    { "tick": 60, "action": "move_x", "value": 0 },
  ],
  "expect": [
    { "at": 100, "check": "hero.transform2d.Position.x > 600" },
    { "at": 1400, "check": "dead.toggle.Toggle.on == false" },
    // 8 / (1/3 a second) = 24 seconds: 1440 ticks.
    { "at": 1450, "check": "carbon.reserve.Reserve.amount == 0" },
    { "at": 1450, "check": "dead.toggle.Toggle.on == true" },
    { "at": 1450, "check": "hero.transform2d.Position.x > 600" },
    // The fade lasts 50 ticks; then everything is back as it was at the start.
    "dead.toggle.Toggle.on == false",
    "checkpoint.checkpoint.Checkpoint.loads == 1",
    "hero.transform2d.Position.x > 399",
    "hero.transform2d.Position.x < 402",
    // 8 again, less the drain of the second since.
    "carbon.reserve.Reserve.amount > 7.2",
  ],
}
