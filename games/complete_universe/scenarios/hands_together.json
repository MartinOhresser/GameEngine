// Black in the left hand, white in the right: both buttons together use the two hands joined (the
// harvest); one button alone uses its hand alone, a tenth of a second later.
{
  "schema_version": 1,
  "name": "hands_together",
  "scene": "sandbox",
  "ticks": 80,
  "inputs": [
    { "tick": 0, "action": "change", "value": 1 },
    { "tick": 1, "action": "hand_right", "value": 1 },
    { "tick": 2, "action": "hand_right", "value": 0 },
    { "tick": 3, "action": "hand_right", "value": 1 },
    { "tick": 4, "action": "hand_right", "value": 0 },
    { "tick": 5, "action": "hand_left", "value": 1 },
    { "tick": 6, "action": "hand_left", "value": 0 },
    { "tick": 7, "action": "change", "value": 0 },
    { "tick": 20, "action": "hand_left", "value": 1 },
    { "tick": 21, "action": "hand_right", "value": 1 },
    { "tick": 40, "action": "hand_left", "value": 0 },
    { "tick": 41, "action": "hand_right", "value": 0 },
    { "tick": 50, "action": "hand_left", "value": 1 },
  ],
  "expect": [
    { "at": 10, "check": "hand_left.loadout.Hand.item == 0" },
    { "at": 10, "check": "hand_right.loadout.Hand.item == 1" },
    { "at": 30, "check": "hand_left.loadout.Hand.joined == true" },
    { "at": 30, "check": "hand_right.loadout.Hand.acting == true" },
    { "at": 52, "check": "hand_left.loadout.Hand.acting == false" },
    "hand_left.loadout.Hand.acting == true",
    "hand_left.loadout.Hand.joined == false",
  ],
}
