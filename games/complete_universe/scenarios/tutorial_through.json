    { "tick": 2495, "action": "pointer_x", "value": 1067 },
    { "tick": 2495, "action": "pointer_y", "value": 736 },
    { "tick": 2500, "action": "harvest", "value": 1 },
    { "tick": 2620, "action": "harvest", "value": 0 },
    { "tick": 2635, "action": "pointer_x", "value": 1005 },
