    { "at": 4300, "check": "hero.transform2d.Position.x > 2850" },
    { "at": 4600, "check": "hero.transform2d.Position.x > 3150" },
    { "at": 4600, "check": "hero.transform2d.Position.y < 600" },
    { "at": 4800, "check": "story.phase.Phase.current == 18" },
    // The white runs low: the fossils of the basin; then the black: the ground dug.
    { "at": 4810, "check": "carbon.reserve.Reserve.amount < 26" },
    { "at": 5080, "check": "story.phase.Phase.current == 19" },
    { "at": 5080, "check": "carbon.reserve.Reserve.amount > 50" },
    { "at": 5140, "check": "story.phase.Phase.current == 20" },
    // Death, on purpose: the matter runs out, then he comes back with his reserves.
    { "at": 5420, "check": "matter.reserve.Reserve.amount < 5" },
    { "at": 5470, "check": "story.phase.Phase.current == 21" },
    { "at": 5470, "check": "checkpoint.checkpoint.Checkpoint.loads == 1" },
    { "at": 5470, "check": "matter.reserve.Reserve.amount > 50" },
    // The departure, under the overhang of the hole he dug: the jump held five seconds, its black hole growing; thrown up, he hits the ground over his head and falls back: to be done again.
