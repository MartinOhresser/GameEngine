    { "tick": 2890, "action": "harvest", "value": 0 },
    // The departure: the black, held towards the sky, as big as it gets.
    { "tick": 3760, "action": "pointer_x", "value": 1000 },
    { "tick": 3760, "action": "pointer_y", "value": 100 },
    { "tick": 3765, "action": "hand_right", "value": 1 },
    { "tick": 3900, "action": "hand_right", "value": 0 },
