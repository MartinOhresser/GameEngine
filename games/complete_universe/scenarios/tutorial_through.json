// The whole tutorial, played by a script: each step ends as the next one starts. The steps are
// numbered in story.phase.Phase.current: landing 0, hands 1, black 2, white 3, together 4,
// inventory 5, harvest 6, walk 7, jump 8, lack_white 9, lack_black 10, departure 11, end 12.
{
  "schema_version": 1,
  "name": "tutorial_through",
  "scene": "tutorial",
  "ticks": 2000,
  "inputs": [
    // 2. Hands: left black; right black then white (the left gives its black back); left black.
    { "tick": 100, "action": "change", "value": 1 },
    { "tick": 102, "action": "hand_left", "value": 1 },
    { "tick": 103, "action": "hand_left", "value": 0 },
    { "tick": 105, "action": "hand_right", "value": 1 },
    { "tick": 106, "action": "hand_right", "value": 0 },
    { "tick": 108, "action": "hand_right", "value": 1 },
    { "tick": 109, "action": "hand_right", "value": 0 },
    { "tick": 111, "action": "hand_left", "value": 1 },
    { "tick": 112, "action": "hand_left", "value": 0 },
    { "tick": 114, "action": "change", "value": 0 },
    // 3a. The black on the rock on the right.
    { "tick": 120, "action": "pointer_x", "value": 760 },
    { "tick": 120, "action": "pointer_y", "value": 589 },
    { "tick": 122, "action": "hand_left", "value": 1 },
    { "tick": 200, "action": "hand_left", "value": 0 },
    // 3b. The white: a small bubble over the landing.
    { "tick": 210, "action": "pointer_x", "value": 540 },
    { "tick": 210, "action": "pointer_y", "value": 520 },
    { "tick": 212, "action": "hand_right", "value": 1 },
    { "tick": 226, "action": "hand_right", "value": 0 },
    // 3c. Both on the rock on the left: the harvest.
    { "tick": 235, "action": "pointer_x", "value": 480 },
    { "tick": 235, "action": "pointer_y", "value": 589 },
    { "tick": 237, "action": "hand_left", "value": 1 },
    { "tick": 237, "action": "hand_right", "value": 1 },
    { "tick": 280, "action": "hand_left", "value": 0 },
    { "tick": 280, "action": "hand_right", "value": 0 },
    // 4. The inventory.
    { "tick": 290, "action": "inventory", "value": 1 },
    { "tick": 291, "action": "inventory", "value": 0 },
    // 5. F on the fossil on the left.
    { "tick": 300, "action": "pointer_x", "value": 380 },
    { "tick": 300, "action": "pointer_y", "value": 589 },
    { "tick": 302, "action": "harvest", "value": 1 },
    { "tick": 350, "action": "harvest", "value": 0 },
    // 6. Walking right; 7. a jump over the pit, held half a charge, then a stronger one onto the
    // ledge.
    { "tick": 365, "action": "move_x", "value": 1 },
    { "tick": 620, "action": "jump", "value": 1 },
    { "tick": 656, "action": "jump", "value": 0 },
    { "tick": 705, "action": "jump", "value": 1 },
    { "tick": 760, "action": "jump", "value": 0 },
    // 8. The white runs low: on to the fossils of the basin.
    { "tick": 990, "action": "move_x", "value": 0 },
    { "tick": 1015, "action": "pointer_x", "value": 656 },
    { "tick": 1015, "action": "pointer_y", "value": 669 },
    { "tick": 1016, "action": "harvest", "value": 1 },
    { "tick": 1136, "action": "harvest", "value": 0 },
    // 9. The black runs low: on to the rocks.
    { "tick": 1145, "action": "move_x", "value": 1 },
    { "tick": 1145, "action": "jump", "value": 1 },
    { "tick": 1170, "action": "jump", "value": 0 },
    { "tick": 1336, "action": "move_x", "value": 0 },
    { "tick": 1365, "action": "pointer_x", "value": 698 },
    { "tick": 1365, "action": "pointer_y", "value": 669 },
    { "tick": 1366, "action": "harvest", "value": 1 },
    { "tick": 1486, "action": "harvest", "value": 0 },
    // 10. The black, held towards the sky, as big as it gets.
    { "tick": 1495, "action": "pointer_x", "value": 900 },
    { "tick": 1495, "action": "pointer_y", "value": 200 },
    { "tick": 1500, "action": "hand_left", "value": 1 },
    { "tick": 1640, "action": "hand_left", "value": 0 },
  ],
  "expect": [
    { "at": 95, "check": "story.phase.Phase.current == 1" },
    { "at": 116, "check": "story.phase.Phase.current == 2" },
    { "at": 205, "check": "story.phase.Phase.current == 3" },
    { "at": 232, "check": "story.phase.Phase.current == 4" },
    { "at": 285, "check": "story.phase.Phase.current == 5" },
    { "at": 295, "check": "story.phase.Phase.current == 6" },
    { "at": 360, "check": "story.phase.Phase.current == 7" },
    // Not walking yet before the walk.
    { "at": 340, "check": "hero.transform2d.Position.x == 600" },
    { "at": 700, "check": "story.phase.Phase.current == 8" },
    { "at": 800, "check": "story.phase.Phase.current == 9" },
    { "at": 805, "check": "carbon.reserve.Reserve.amount < 26" },
    { "at": 1130, "check": "fossil_1 gone" },
    { "at": 1130, "check": "fossil_2 gone" },
    { "at": 1140, "check": "story.phase.Phase.current == 10" },
    { "at": 1145, "check": "matter.reserve.Reserve.amount < 26" },
    { "at": 1480, "check": "rock_2 gone" },
    { "at": 1480, "check": "rock_3 gone" },
    { "at": 1490, "check": "story.phase.Phase.current == 11" },
    { "at": 1560, "check": "story.phase.Phase.current == 11" },
    { "at": 1650, "check": "story.phase.Phase.current == 12" },
    { "at": 1650, "check": "checkpoint.checkpoint.Checkpoint.loads == 0" },
    // The departure: the black hole runs away and grows, the ground shakes, the dome melts.
    { "at": 1700, "check": "runaway.attractor2d.Attractor.radius > 150" },
    { "at": 1700, "check": "camera.camera2d.CameraShake.strength > 5" },
    { "at": 1880, "check": "dome.sprite2d.Sprite.alpha < 30" },
    // Then white, and the drift in space (another scene: its sleeper).
    "sleeper alive",
  ],
}
