    { "at": 3420, "check": "world_speed.transform2d.WorldSpeed.factor == 0.25" },
    { "at": 3500, "check": "world_speed.transform2d.WorldSpeed.factor == 1" },
    { "at": 3440, "check": "hero.transform2d.Position.y < 400" },
    // Over the pit, onto the ledge.
    { "at": 3795, "check": "story.phase.Phase.current == 16" },
