  "expect": [
    { "at": 160, "check": "story.phase.Phase.current == 0" },
    // Nothing happens before its step: the hero cannot walk yet.
    { "at": 160, "check": "hero.transform2d.Position.x == 600" },
    { "at": 330, "check": "black_hole.attractor2d.Attractor.swallowed == 2" },
    { "at": 330, "check": "story.phase.Phase.current == 2" },
    { "at": 690, "check": "story.phase.Phase.current == 3" },
    { "at": 770, "check": "white_caster.barrier2d.Caster.raised == 2" },
    { "at": 770, "check": "story.phase.Phase.current == 4" },
    { "at": 1150, "check": "story.phase.Phase.current == 5" },
    { "at": 1290, "check": "carbon.reserve.Reserve.gained == 30" },
    { "at": 1290, "check": "story.phase.Phase.current == 6" },
    { "at": 1590, "check": "story.phase.Phase.current == 7" },
    { "at": 1795, "check": "story.phase.Phase.current == 9" },
    { "at": 2055, "check": "story.phase.Phase.current == 10" },
    { "at": 2300, "check": "story.phase.Phase.current == 11" },
    { "at": 2400, "check": "story.phase.Phase.current == 12" },
    { "at": 2405, "check": "carbon.reserve.Reserve.amount < 26" },
    { "at": 2625, "check": "carbon.reserve.Reserve.amount > 50" },
    { "at": 2625, "check": "fossil_2 gone" },
    { "at": 2625, "check": "story.phase.Phase.current == 13" },
    { "at": 2630, "check": "matter.reserve.Reserve.amount < 26" },
    // Digging under his feet: he goes down into the planet, and the camera with him.
    { "at": 2895, "check": "hero.transform2d.Position.y > 800" },
    { "at": 2895, "check": "camera.transform2d.Position.y > 700" },
    { "at": 2895, "check": "story.phase.Phase.current == 14" },
    // Death, on purpose: the matter runs out, then he comes back with his reserves.
    { "at": 3250, "check": "matter.reserve.Reserve.amount < 10" },
    { "at": 3400, "check": "story.phase.Phase.current == 15" },
    { "at": 3400, "check": "checkpoint.checkpoint.Checkpoint.loads == 1" },
    { "at": 3400, "check": "matter.reserve.Reserve.amount > 70" },
    { "at": 3750, "check": "story.phase.Phase.current == 16" },
    { "at": 3900, "check": "story.phase.Phase.current == 17" },
    // The departure: the black hole runs away and grows, the ground shakes, the dome melts.
    { "at": 3960, "check": "runaway.attractor2d.Attractor.radius > 150" },
    { "at": 3960, "check": "camera.camera2d.CameraShake.strength > 5" },
    { "at": 4150, "check": "dome.sprite2d.Sprite.alpha < 30" },
    // Then white, and the drift in space (another scene: its sleeper).
    "sleeper alive",
  ],
}
