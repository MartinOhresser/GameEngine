    { "at": 3925, "check": "story.phase.Phase.current == 17" },
    { "at": 4355, "check": "hero.transform2d.Position.x > 2850" },
    { "at": 4655, "check": "hero.transform2d.Position.x > 3150" },
    { "at": 4655, "check": "hero.transform2d.Position.y < 600" },
    { "at": 4855, "check": "story.phase.Phase.current == 18" },
    // The white runs low: the fossils of the basin; then the black: the ground dug.
    { "at": 4865, "check": "carbon.reserve.Reserve.amount < 26" },
    { "at": 5135, "check": "story.phase.Phase.current == 19" },
    { "at": 5135, "check": "carbon.reserve.Reserve.amount > 50" },
    { "at": 5195, "check": "story.phase.Phase.current == 20" },
    // Death, on purpose: the matter runs out, then he comes back with his reserves.
    { "at": 5475, "check": "matter.reserve.Reserve.amount < 5" },
    { "at": 5535, "check": "story.phase.Phase.current == 21" },
    { "at": 5535, "check": "checkpoint.checkpoint.Checkpoint.loads == 1" },
    { "at": 5535, "check": "matter.reserve.Reserve.amount > 50" },
    // The departure, in the hole he dug: the jump held full five seconds, then its black hole growing, the jump stronger; a wall of white raised over his head meanwhile; let go, he hits it and falls back: to be done again.
    { "at": 6045, "check": "story.phase.Phase.current == 22" },
    { "at": 6305, "check": "jump_hole.sprite2d.Sprite.width == 2" },
    { "at": 6535, "check": "jump_hole.sprite2d.Sprite.width > 4" },
    { "at": 6535, "check": "hero.jump.Jumper.speed > 1800" },
    { "at": 6615, "check": "story.phase.Phase.current == 22" },
    { "at": 6615, "check": "hero.transform2d.Position.y > 700" },
    { "at": 6615, "check": "hero.jump.Jumper.speed == 560" },
