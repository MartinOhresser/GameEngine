// Complete Universe: a being made of ovals gathers the fragments of power its own explosion
// scattered, and gives an universe of black and white its colours back. The design is in
// docs/complete_universe; the pictures and the scenes are generated by tools/make_assets.py.
{
  "schema_version": 1,
  "name": "complete_universe",
  "title": "Complete Universe",
  "description": "A being of black and white ovals crosses a grey universe with two hands of power: a black hole and a barrier. Harvest, survive, and give the universe its colours back.",
  "modules": [
    "transform2d", "sprite2d", "camera2d", "collision2d", "gravity2d", "action_control", "jump",
    "tag", "terrain2d", "reserve", "bind", "postfx", "aim2d", "loadout", "follow2d", "attractor2d",
    "barrier2d", "toggle", "rules", "checkpoint", "spawner2d", "bounds2d", "tween2d",
    "phase", "text2d", "particles2d", "scene_switch",
  ],
  "lists": {
    "action": [
      "move_x", "jump", "out_of_matter", "out_of_carbon", "hand_left", "hand_right", "change",
      "pointer_x", "pointer_y", "harvest", "inventory", "take_off",
      "revive", "locked", "landed", "hands_ready", "black_done", "white_done", "together_done",
      "inventory_done", "harvest_done", "walk_done", "jump_done", "white_ok", "black_ok",
      "departed", "skip", "exploded",
    ],
    "layer": ["hero", "ground", "rock", "barrier"],
    "tag": [
      "hero", "camera", "matter", "carbon", "black_hole", "white_caster", "harvest_bubble",
      "inventory", "matter_bubble", "carbon_bubble", "jump_hole", "dead",
      "kit", "story", "stars", "nebula", "flash", "great_barrier", "planet", "sleeper",
      "whiteout", "whitein", "dome", "runaway", "blast", "to_follow",
    ],
    // One kind of resource for each power (GDD §7): matter feeds the black, carbon the white.
    "resource": ["matter", "carbon"],
    // The steps of the tutorial (docs/complete_universe/TUTORIEL.md).
    "phase": [
      "landing", "hands", "black", "white", "together", "inventory", "harvest", "walk", "jump",
      "lack_white", "lack_black", "departure", "end",
    ],
    // The powers a hand can hold (GDD §6), then what two hands make together.
    "power": [
      "black", "white", "blue", "green", "red", "yellow", "orange", "violet", "pink", "harvest",
    ],
  },
  "simulation": { "tick_rate": 60, "seed": 11 },
  "window": { "width": 1280, "height": 720 },
  "input": "input.json",
  "strings": ["text/fr.json"],
  "locale": "fr",
  "atlases": [
    "art/sky.json", "art/hero.json", "art/arm.json", "art/black_hole.json", "art/rock.json",
    "art/barrier.json", "art/harvest.json", "art/fossil.json", "art/inventory.json",
    "art/plain.json", "art/font.json", "art/glow.json", "art/planet.json", "art/nebula.json",
    "art/hero_curled.json",
  ],
  "prefabs": ["prefabs/fade_white.json", "prefabs/fade_black.json", "prefabs/fade_back.json"],
  "scenes": [
    "scenes/opening.json", "scenes/tutorial.json", "scenes/drift.json", "scenes/sandbox.json",
    "scenes/sandbox_low.json",
  ],
  "scenarios": [
    "scenarios/walks.json", "scenarios/jumps.json", "scenarios/terrain.json",
    "scenarios/life_drains.json", "scenarios/edges_turn.json", "scenarios/assigns_hands.json",
    "scenarios/wheel.json", "scenarios/hands_together.json", "scenarios/black_hole.json",
    "scenarios/barrier_catches_rock.json", "scenarios/harvest_sorts.json",
    "scenarios/inventory_opens.json", "scenarios/walking_costs.json",
    "scenarios/charged_jump.json", "scenarios/dies_and_restarts.json",
    "scenarios/tutorial_through.json", "scenarios/cannot_walk_early.json",
    "scenarios/opening.json", "scenarios/opening_skips.json",
  ],
  "start_scene": "opening",
}
