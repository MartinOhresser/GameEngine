// Complete Universe: a being made of ovals gathers the fragments of power its own explosion
// scattered, and gives an universe of black and white its colours back. The design is in
// docs/complete_universe; the pictures and the scenes are generated by tools/make_assets.py.
{
  "schema_version": 1,
  "name": "complete_universe",
  "title": "Complete Universe",
  "description": "A being of black and white ovals crosses a grey universe with two hands of power: a black hole and a barrier. Harvest, survive, and give the universe its colours back.",
  "modules": [
    "transform2d", "sprite2d", "camera2d", "collision2d", "gravity2d", "action_control", "jump",
    "tag", "terrain2d", "reserve", "bind", "postfx", "aim2d", "loadout", "follow2d", "attractor2d",
    "barrier2d",
  ],
  "lists": {
    "action": [
      "move_x", "jump", "out_of_matter", "out_of_carbon", "hand_left", "hand_right", "change",
      "pointer_x", "pointer_y",
    ],
    "layer": ["hero", "ground", "rock", "barrier"],
    "tag": ["hero", "camera", "matter", "carbon", "black_hole", "white_caster"],
    // One kind of resource for each power (GDD §7): matter feeds the black, carbon the white.
    "resource": ["matter", "carbon"],
    // The powers a hand can hold (GDD §6), then what two hands make together.
    "power": [
      "black", "white", "blue", "green", "red", "yellow", "orange", "violet", "pink", "harvest",
    ],
  },
  "simulation": { "tick_rate": 60, "seed": 11 },
  "window": { "width": 1280, "height": 720 },
  "input": "input.json",
  "atlases": [
    "art/sky.json", "art/hero.json", "art/arm.json", "art/black_hole.json", "art/rock.json",
    "art/barrier.json",
  ],
  "scenes": ["scenes/sandbox.json", "scenes/sandbox_low.json"],
  "scenarios": [
    "scenarios/walks.json", "scenarios/jumps.json", "scenarios/terrain.json",
    "scenarios/life_drains.json", "scenarios/edges_turn.json", "scenarios/assigns_hands.json",
    "scenarios/wheel.json", "scenarios/hands_together.json", "scenarios/black_hole.json",
    "scenarios/barrier_catches_rock.json",
  ],
  "start_scene": "sandbox",
}
