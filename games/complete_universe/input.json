// The controls of docs/complete_universe/TUTORIEL.md: Q/D (or A/D) and the arrows walk, Space
// jumps, the two mouse buttons are the two hands, Shift changes a hand's colour (held: the wheel),
// F harvests, Tab opens the inventory, Escape pauses.
{
  "schema_version": 1,
  "bindings": [
    { "action": "move_x", "sources": { "key:right": 1, "key:d": 1, "key:left": -1, "key:q": -1, "key:a": -1 } },
    { "action": "jump", "sources": { "key:space": 1 } },
    { "action": "hand_left", "sources": { "mouse:left": 1 } },
    { "action": "hand_right", "sources": { "mouse:right": 1 } },
    { "action": "change", "sources": { "key:left_shift": 1, "key:right_shift": 1 } },
    { "action": "pointer_x", "sources": { "mouse:x": 1 } },
    { "action": "pointer_y", "sources": { "mouse:y": 1 } },
  ],
}
