    {
      "tick": 300,
      "action": "start_wave",
      "value": 1
    },
    {
      "tick": 301,
      "action": "start_wave",
      "value": 0
    }
  ],
  "expect": [
    {
      "at": 320,
      "check": "waves.waves.WaveController.current == 2"
