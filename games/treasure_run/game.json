// "Explore a walled room, avoid the spikes and collect the treasure."
// The reference game of 2D rendering (M7) and of the interface (M8): atlases, sprites,
// a camera that follows the hero, solid walls, a menu, a HUD, a hotbar whose slots
// have rules of their own, texts in two languages and a change of scene.
// Pictures and scenes are generated by tools/make_assets.py.
{
  "schema_version": 1,
  "name": "treasure_run",
  "title": "Treasure Run",
  "description": "Walk a hero around a walled room with the arrow keys or WASD, collecting coins and gems. The camera follows the hero and the walls stop it.",
  "modules": [
    "transform2d", "action_control", "pickup", "sprite2d", "text2d", "camera2d", "collision2d",
    "scene_switch", "ui", "inventory", "host", "touch_controls",
  ],
  "simulation": { "tick_rate": 60, "seed": 5 },
  "input": "input.json",
  // The names this game gives to things: menus, groups of cells, containers, kinds and
// categories of items, tags and its own actions (the others come from input.json).
  "lists": {
    "action": ["start_game", "show_credits", "quit_game", "move_x", "move_y"],
    "menu": ["main_menu"],
    "group": ["menu_buttons", "hotbar", "touch_stick"],
    "tag": ["player"],
    "container": ["backpack"],
    "item_kind": ["key", "sword", "potion"],
    "category": ["tool", "weapon", "consumable"],
  },
  "atlases": ["art/tiles.json", "art/hero.json", "art/font.json", "art/ui.json"],
  "strings": ["text/en.json", "text/fr.json"],
  "locale": "en",
  "prefabs": [
    "prefabs/floor_a.json",
    "prefabs/floor_b.json",
    "prefabs/wall.json",
    "prefabs/spikes.json",
    "prefabs/coin.json",
    "prefabs/gem.json",
    "prefabs/player.json",
    "prefabs/camera.json",
    "prefabs/button.json",
    "prefabs/slot.json",
    "prefabs/key.json",
    "prefabs/sword.json",
    "prefabs/potion.json",
  ],
  "scenes": ["scenes/menu.json", "scenes/main.json", "scenes/credits.json"],
  "scenarios": [
    "scenarios/walk_into_a_wall.json",
    "scenarios/touch_stick_walks.json",
    "scenarios/collect_coins.json",
    "scenarios/spikes_are_felt.json",
    "scenarios/camera_follows.json",
    "scenarios/hero_walks.json",
    "scenarios/gather_items.json",
    "scenarios/slots_have_rules.json",
    "scenarios/hotbar_hand.json",
    "scenarios/menu_choose.json",
    "scenarios/menu_play.json",
    "scenarios/menu_pointer.json",
    "scenarios/quit_from_the_menu.json",
  ],
  "start_scene": "menu",
}
