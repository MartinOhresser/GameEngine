// "Explore a walled room, avoid the spikes and collect the treasure."
// The reference game of 2D rendering (M7): atlases, sprites, an animation, a
// camera that follows the hero, solid walls and tiles that are plain entities.
// Pictures and scene are generated by tools/make_assets.py.
{
  "schema_version": 1,
  "name": "treasure_run",
  "description": "Walk a hero around a walled room with the arrow keys or WASD, collecting coins and gems. The camera follows the hero and the walls stop it.",
  "modules": ["transform2d", "action_control", "pickup", "sprite2d", "text2d", "camera2d", "collision2d"],
  "simulation": { "tick_rate": 60, "seed": 5 },
  "input": "input.json",
  "atlases": ["art/tiles.json", "art/hero.json", "art/font.json"],
  "strings": ["text/en.json", "text/fr.json"],
  "locale": "en",
  "prefabs": [
    "prefabs/floor_a.json",
    "prefabs/floor_b.json",
    "prefabs/wall.json",
    "prefabs/spikes.json",
    "prefabs/coin.json",
    "prefabs/gem.json",
    "prefabs/player.json",
    "prefabs/camera.json",
  ],
  "scenes": ["scenes/main.json"],
  "scenarios": [
    "scenarios/walk_into_a_wall.json",
    "scenarios/collect_coins.json",
    "scenarios/spikes_are_felt.json",
    "scenarios/camera_follows.json",
    "scenarios/hero_walks.json",
  ],
  "start_scene": "main",
}
