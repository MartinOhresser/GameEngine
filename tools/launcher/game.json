// "Browse the games of the engine and play them."
// The launcher is a game like the others, made of JSON files. Its list of games and the lines
// about the selected game are run-time lists that the host (gelauncher) fills; Enter or a click
// on a game asks the host to play it, and the host brings this screen back when the game ends.
// The picture and the scene are generated by tools/make_assets.py.
{
  "schema_version": 1,
  "name": "launcher",
  "title": "Game Engine launcher",
  "description": "Lists the games of the engine, shows what each one is made of, and plays the one you choose.",
  "modules": ["transform2d", "sprite2d", "text2d", "ui", "host"],
  "simulation": { "tick_rate": 60, "seed": 1 },
  "window": { "width": 800, "height": 560 },
  "input": "input.json",
  "lists": {
    // `play_game` and `quit_game` come from the buttons, `page_prev` and `page_next` from the keys too.
    "action": ["play_game", "quit_game", "page_prev", "page_next"],
    "menu": ["main_menu"],
    // Filled by the host: the games, and the lines about the selected one.
    "runtime_list": ["games", "details"],
    "host_command": ["play"],
  },
  "atlases": ["art/ui.json", "art/font.json"],
  "strings": ["text/en.json", "text/fr.json"],
  "locale": "en",
  "scenes": ["scenes/main.json"],
  "scenarios": [
    "scenarios/lists_the_games.json",
    "scenarios/choose_and_play.json",
    "scenarios/turns_the_pages.json",
    "scenarios/quit_button.json",
    "scenarios/no_games.json",
  ],
  "start_scene": "main",
}
