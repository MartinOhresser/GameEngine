// "Browse the games of the engine and play them."
// The launcher is a game like the others, made of JSON files. Its list of games and the lines
// about the selected game are run-time lists that the host (gelauncher) fills; Enter or a click
// on a game asks the host to play it, and the host brings this screen back when the game ends.
// The picture and the scene are generated by tools/make_assets.py.
{
  "schema_version": 1,
  "name": "launcher",
  "title": "Game Engine launcher",
  "description": "Lists the games of the engine, shows what each one is made of, and plays the one you choose.",
  "modules": ["transform2d", "sprite2d", "text2d", "ui", "host", "collision2d", "scene_switch"],
  "simulation": { "tick_rate": 60, "seed": 1 },
  "window": { "width": 800, "height": 560 },
  "input": "input.json",
  "lists": {
    // The buttons raise `play_game`, `quit_game`, `open_export`, `start_export` and `back_main`;
    // `page_prev` and `page_next` come from the keys too. `back_main` is also bound to Backspace.
    "action": [
      "play_game", "quit_game", "page_prev", "page_next", "open_export", "start_export",
      "back_main", "targets_prev", "targets_next",
    ],
    "menu": ["main_menu", "export_menu"],
    // Filled by the host: the games, the lines about the selected one, the platforms an export
    // can be made for, and the lines of the export screen.
    "runtime_list": ["games", "details", "targets", "export"],
    "host_command": ["play", "export"],
  },
  "atlases": ["art/ui.json", "art/font.json"],
  "strings": ["text/en.json", "text/fr.json"],
  "locale": "en",
  "scenes": ["scenes/main.json", "scenes/export.json"],
  "scenarios": [
    "scenarios/lists_the_games.json",
    "scenarios/choose_and_play.json",
    "scenarios/turns_the_pages.json",
    "scenarios/quit_button.json",
    "scenarios/no_games.json",
    "scenarios/open_export.json",
    "scenarios/start_export.json",
    "scenarios/back_from_export.json",
  ],
  "start_scene": "main",
}
