// Up from the first row goes round to the Quit button, Enter presses it.
{
  "schema_version": 1,
  "name": "quit_button",
  "ticks": 20,
  "lists": {
    "games": [
      "Alpha",
      "Beta",
      "Gamma"
    ]
  },
  "inputs": [
    {
      "tick": 3,
      "action": "menu_up",
      "value": 1
    },
    {
      "tick": 4,
      "action": "menu_up",
      "value": 0
    },
    {
      "tick": 8,
      "action": "menu_accept",
      "value": 1
    },
    {
      "tick": 9,
      "action": "menu_accept",
      "value": 0
    }
  ],
  "expect": [
    {
      "at": 6,
      "check": "controller.ui.Menu.focused == 10"
    },
    {
      "at": 6,
      "check": "list games selected == 0"
    },
    "game quits"
  ]
}
