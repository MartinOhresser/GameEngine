// Up and Down choose a game (or the row of buttons below), Left and Right move along a row of
// buttons, Enter plays or presses, Page Up and Page Down turn the pages, Backspace leaves the
// export screen, the mouse does the same by pointing and clicking. Escape belongs to the host.
{
  "schema_version": 1,
  "bindings": [
    { "action": "menu_up", "sources": { "key:up": 1, "key:w": 1 } },
    { "action": "menu_down", "sources": { "key:down": 1, "key:s": 1 } },
    { "action": "menu_left", "sources": { "key:left": 1, "key:a": 1 } },
    { "action": "menu_right", "sources": { "key:right": 1, "key:d": 1 } },
    { "action": "menu_accept", "sources": { "key:return": 1, "key:space": 1 } },
    { "action": "page_prev", "sources": { "key:pageup": 1 } },
    { "action": "page_next", "sources": { "key:pagedown": 1 } },
    { "action": "back_main", "sources": { "key:backspace": 1 } },
    { "action": "pointer_x", "sources": { "mouse:x": 1 } },
    { "action": "pointer_y", "sources": { "mouse:y": 1 } },
    { "action": "click", "sources": { "mouse:left": 1 } },
  ],
}
