# The registry of a program: the list of modules it links, as code that the game runtime reads
# (`ge::runner::linked_modules()`). The runner links every module of the repository; a player
# (the program of an exported game) links only the ones its game uses.
#
#   ge_write_registry(<output .cpp file> <module>...)
function(ge_write_registry output)
  set(registry_includes "")
  set(registry_entries "")
  foreach(name IN LISTS ARGN)
    string(APPEND registry_includes "#include \"ge/mod/${name}/${name}.gen.hpp\"\n")
    string(APPEND registry_entries
           "    {&ge::mod::${name}::info, &ge::mod::${name}::install},\n")
  endforeach()
  list(LENGTH ARGN module_count)
  file(CONFIGURE OUTPUT "${output}" CONTENT [[
// Generated by CMake from the list of modules. Do not edit.
#include "registry.hpp"

#include <array>

@registry_includes@
namespace ge::runner {

std::span<const game::ModuleEntry> linked_modules() {
    static const std::array<game::ModuleEntry, @module_count@> entries = {{
@registry_entries@    }};
    return entries;
}

} // namespace ge::runner
]] @ONLY)
endfunction()
